.terraform/
# .terraform.lock.hcl is intentionally NOT ignored — commit it so everyone
# resolves the same provider versions.
terraform.tfstate
terraform.tfstate.*
terraform.tfstate.d/
crash.log
*.tfplan

# Local Terraform override files (never used here, but a common accidental-commit risk)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config that can contain credentials/tokens if you ever use one
.terraformrc
terraform.rc
